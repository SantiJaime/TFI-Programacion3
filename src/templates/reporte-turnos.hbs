<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 13px; color: #222; padding: 40px; }

    .header { text-align: center; margin-bottom: 32px; border-bottom: 3px solid #1a5276; padding-bottom: 16px; }
    .header h1 { font-size: 22px; color: #1a5276; letter-spacing: 1px; }
    .header h2 { font-size: 14px; color: #555; font-weight: normal; margin-top: 4px; }

    .meta { display: flex; justify-content: space-between; margin-bottom: 24px; font-size: 12px; color: #555; }

    .resumen { display: flex; gap: 16px; margin-bottom: 28px; }
    .card { flex: 1; background: #eaf0fb; border-radius: 6px; padding: 14px 18px; text-align: center; }
    .card .valor { font-size: 24px; font-weight: bold; color: #1a5276; }
    .card .label { font-size: 11px; color: #666; margin-top: 4px; }

    table { width: 100%; border-collapse: collapse; margin-bottom: 32px; }
    thead tr { background: #1a5276; color: #fff; }
    thead th { padding: 9px 12px; text-align: left; font-size: 12px; }
    tbody tr:nth-child(even) { background: #f4f6f9; }
    tbody td { padding: 8px 12px; border-bottom: 1px solid #ddd; font-size: 12px; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: bold; }
    .badge-atendido { background: #d5f5e3; color: #1e8449; }
    .badge-pendiente { background: #fdebd0; color: #a04000; }

    .footer { text-align: center; font-size: 11px; color: #aaa; border-top: 1px solid #ddd; padding-top: 12px; }
  </style>
</head>
<body>
  <div class="header">
    <h1>CLÍNICA MÉDICA — SISTEMA DE GESTIÓN DE TURNOS</h1>
    <h2>Informe General de Turnos y Auditoría</h2>
  </div>

  <div class="meta">
    <span>Fecha de emisión: {{fechaEmision}}</span>
    <span>Total de registros: {{totalTurnos}}</span>
  </div>

  <div class="resumen">
    <div class="card">
      <div class="valor">{{totalTurnos}}</div>
      <div class="label">Turnos activos</div>
    </div>
    <div class="card">
      <div class="valor">{{atendidos}}</div>
      <div class="label">Atendidos</div>
    </div>
    <div class="card">
      <div class="valor">{{pendientes}}</div>
      <div class="label">Pendientes</div>
    </div>
    <div class="card">
      <div class="valor">${{facturacionTotal}}</div>
      <div class="label">Facturación total</div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Fecha y hora</th>
        <th>Paciente</th>
        <th>Médico</th>
        <th>Especialidad</th>
        <th>Obra Social</th>
        <th>Valor Total</th>
        <th>Estado</th>
      </tr>
    </thead>
    <tbody>
      {{#each turnos}}
      <tr>
        <td>{{numero}}</td>
        <td>{{fecha}}</td>
        <td>{{paciente}}</td>
        <td>{{medico}}</td>
        <td>{{especialidad}}</td>
        <td>{{obra_social}}</td>
        <td>${{valor_total}}</td>
        <td>
          {{#if atendido}}
            <span class="badge badge-atendido">Atendido</span>
          {{else}}
            <span class="badge badge-pendiente">Pendiente</span>
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="footer">
    Documento generado automáticamente — Clínica Médica &copy; {{anio}}
  </div>
</body>
</html>
